PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=https://your-production-domain.vercel.app
NODE_ENV=production
MONGODB_MAX_POOL_SIZE=10
SEED_ADMIN_PASSWORD=replace_with_a_unique_secret_at_least_16_characters
SEED_DEMO_PASSWORD=replace_with_a_different_secret_at_least_16_characters
